# 可选：本地凭证覆盖。
# 把本文件复制为 .env.local 并填入真实值；.env.local 不纳入版本控制。
# 不填也可以：服务端会回退去读本机 MiniMax 配置文件
#   %USERPROFILE%\.minimax\agents\coder\config.yaml
#   %USERPROFILE%\.minimax\config.yaml
#
# 解析顺序为逐字段合并，先到先得：
#   1) 环境变量
#   2) .env.local
#   3) 上述 MiniMax 配置文件

# 本账号 API Key
MBTI_API_KEY=

# 接口地址（OpenAI 兼容协议用 /chat/completions，Anthropic 协议用 /messages）
MBTI_BASE_URL=https://api.minimaxi.com/v1

# 模型名
MBTI_MODEL=MiniMax-M2.7

# 协议：openai | anthropic；留空则从配置文件的 npm 字段推断
MBTI_PROTOCOL=openai

# 服务端口（默认 5173）
PORT=5173
